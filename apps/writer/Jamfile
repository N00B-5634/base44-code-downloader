SubDir HAIKU_TOP apps writer ;

# YellowDocs Writer application

# Application executable
Application yellowdocs-writer :
	# Source files
	src/main.cpp
	src/YellowDocsWriterApp.h
	src/YellowDocsWriterApp.cpp
	src/MainWindow.h
	src/MainWindow.cpp
	src/DocumentWindow.h
	src/DocumentWindow.cpp
	src/EditorView.h
	src/EditorView.cpp
	src/ToolbarView.h
	src/ToolbarView.cpp
	src/StatusView.h
	src/StatusView.cpp
	src/FilePanel.h
	src/FilePanel.cpp
	src/PrintView.h
	src/PrintView.cpp
	src/PreferencesWindow.h
	src/PreferencesWindow.cpp
	src/AboutWindow.h
	src/AboutWindow.cpp
	src/FindPanel.h
	src/FindPanel.cpp
	src/ReplacePanel.h
	src/ReplacePanel.cpp
	
	# Resources
	resources:
		resources/app_icon.png
		resources/document_icon.png
		resources/toolbar_icons
		
		# Include resource definitions
		: resources/YellowDocsWriter.rdef
	
	# Library dependencies
	: be trackersupport libyellowdocs-core.a libyellowdocs-ui.a libyellowdocs-utils.a
	
	# Compiler flags
	: -DYELLOWDOCS_WRITER_APP
	
	# Application info
	: APP_NAME="YellowDocs Writer"
	: APP_VERSION="1.0.0"
	: APP_SIGNATURE="application/x-vnd.yellowdocs-writer-app"
	: APP_MIME_TYPE="application/x-vnd.yellowdocs-writer-app"
	
	# Install to apps directory
	: bin
;

# Resource definitions
ResourceFile resources/YellowDocsWriter.rdef :
	resources/YellowDocsWriter.rdef
	
	: resources
;

# Install application to apps directory
InstallApplication : yellowdocs-writer
	: bin
	: "YellowDocs Writer"
;

# Install MIME type
InstallMIME :
	: mimetypes application/x-vnd.yellowdocs-writer
	: "YellowDocs Writer Document"
	: "application/x-vnd.yellowdocs-writer-app"
	: ".ywrite"
;
