# Haiku Build Rules
# Minimal Jam rules for building Haiku applications

# Compiler settings
CC ?= gcc ;
C++ ?= g++ ;

CCFLAGS ?= -O2 ;
C++FLAGS ?= -O2 ;

# Haiku-specific flags
CCFLAGS += -DHAIKU -D_BEOS -D__HAIKU__ ;
C++FLAGS += -DHAIKU -D_BEOS -D__HAIKU__ ;

# Linker settings
LINKFLAGS ?= ;

# Tool paths
AR ?= ar ;
RANLIB ?= ranlib ;
RESC ?= rc ;

# File suffixes
SUFOBJ ?= .o ;
