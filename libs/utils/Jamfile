	# Source files
	src/FileUtils.cpp
	src/MIMEUtils.cpp
	src/StringUtils.cpp
	src/Preferences.cpp
	src/ClipboardUtils.cpp
	
	# Library dependencies
	: be trackersupport
	
	# Compiler flags
